      "年成": "勤耕豐收",
      "求嗣": "健壯之子",
      "移居": "利於發展",
      "失物": "努力可尋",
      "出行": "東南方利",
      "家宅": "蒸蒸日上",
      "訴訟": "氣勢如虹",
      "學業": "自強不息，必出人頭"
