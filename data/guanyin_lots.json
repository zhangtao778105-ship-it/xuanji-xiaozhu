      "年成": "異地收成",
      "求嗣": "遠方之子",
      "移居": "遠遷可安",
      "失物": "遺落他方",
      "出行": "遠行孤寂",
      "家宅": "人去樓空",
      "訴訟": "難以申辯",
      "學業": "遠走他方，異地求學"
