[
  {
    "id": 1,
    "level": "上上签",
    "title": "鐘離成道",
    "poem": "巍巍寶塔放光明\n照破乾坤萬里程\n借問世間何處好\n靈山會上禮觀音",
    "judgment": "此簽大吉，凡事亨通，猶如寶塔放光，前途一片光明。",
    "interpretation": {
      "功名": "名列前茅",
      "婚姻": "天作之合",
      "求財": "利市三倍",
      "疾病": "藥到病除",
      "行人": "平安歸來",
      "年成": "五穀豐登",
      "求嗣": "喜得貴子",
      "移居": "喬遷大吉",
      "失物": "失而復得",
      "出行": "一帆風順",
      "家宅": "闔家平安",
      "訴訟": "理直氣壯",
      "學業": "文星高照，金榜題名"
    }
  },
  {
    "id": 2,
    "level": "上吉签",
    "title": "姜太公釣魚",
    "poem": "渭水河邊一釣竿\n風霜雨雪不知寒\n世人不識真龍面\n只待文王降世間",
    "judgment": "時運未至，暫且忍耐，必有貴人相助，終成大業。",
    "interpretation": {
      "功名": "待時而發",
      "婚姻": "良緣可待",
      "求財": "時來運轉",
      "疾病": "耐心調理",
      "行人": "歸期不遠",
      "年成": "風調雨順",
      "求嗣": "求之可得",
      "移居": "暫緩為宜",
      "失物": "尋之可得",
      "出行": "稍待時日",
      "家宅": "安穩無虞",
      "訴訟": "以和為貴",
      "學業": "待時而發，功名可期"
    }
  },
  {
    "id": 3,
    "level": "中吉签",
    "title": "蘇武牧羊",
    "poem": "北海風霜十九年\n忠心一片動皇天\n終須有日回朝去\n青史留名萬古傳",
    "judgment": "歷經磨難不改其志，終有雲開見日之時。",
    "interpretation": {
      "功名": "終必有成",
      "婚姻": "守得雲開",
      "求財": "先難後易",
      "疾病": "慢慢康復",
      "行人": "遠歸有望",
      "年成": "先旱後雨",
      "求嗣": "遲來之喜",
      "移居": "待時而動",
      "失物": "日久出現",
      "出行": "宜耐心行",
      "家宅": "守成則吉",
      "訴訟": "持久得勝",
      "學業": "守得雲開，終必有成"
    }
  },
  {
    "id": 4,
    "level": "中平签",
    "title": "莊子試妻",
    "poem": "夢裡繁華總是空\n醒來萬事一般同\n世人若信莊周語\n何必尋求紙上功",
    "judgment": "凡事虛幻無常，不可強求，順其自然可得平安。",
    "interpretation": {
      "功名": "虛名勿戀",
      "婚姻": "平淡是福",
      "求財": "知足常樂",
      "疾病": "靜心養性",
      "行人": "音信渺茫",
      "年成": "收成平平",
      "求嗣": "順其自然",
      "移居": "不動為宜",
      "失物": "難尋勿念",
      "出行": "宜靜勿動",
      "家宅": "平安即可",
      "訴訟": "退一步安",
      "學業": "莫戀虛名，務實求真"
    }
  },
  {
    "id": 5,
    "level": "中上签",
    "title": "劉備招親",
    "poem": "東吳招贅結良緣\n錦繡前程在眼前\n月老紅繩牽兩地\n花開連理慶團圓",
    "judgment": "喜事臨門，婚姻美滿，凡事皆有貴人相助。",
    "interpretation": {
      "功名": "得遇貴人",
      "婚姻": "美滿姻緣",
      "求財": "合作有利",
      "疾病": "良醫可癒",
      "行人": "喜訊將至",
      "年成": "豐收在望",
      "求嗣": "喜得麟兒",
      "移居": "吉地可遷",
      "失物": "貴人指引",
      "出行": "大利南方",
      "家宅": "喜氣洋洋",
      "訴訟": "和解為上",
      "學業": "得遇良師，學業精進"
    }
  },
  {
    "id": 6,
    "level": "中吉签",
    "title": "八仙過海",
    "poem": "蓬萊仙境聚群仙\n各顯神通渡海天\n世事紛紜皆有定\n從容應對自安然",
    "judgment": "各憑本事，各顯神通，隨機應變可保平安。",
    "interpretation": {
      "功名": "各展所長",
      "婚姻": "各得其所",
      "求財": "多方經營",
      "疾病": "變通治療",
      "行人": "分頭尋訪",
      "年成": "多種多收",
      "求嗣": "另有機緣",
      "移居": "可多方選",
      "失物": "多方尋找",
      "出行": "隨機應變",
      "家宅": "平安順遂",
      "訴訟": "靈活應對",
      "學業": "各展所長，學有所成"
    }
  },
  {
    "id": 7,
    "level": "中平签",
    "title": "唐僧取經",
    "poem": "西行萬里路迢迢\n九九災魔劫未消\n但得真經歸故土\n功成圓滿樂逍遙",
    "judgment": "前路艱難，須經磨難方得正果，勿輕言放棄。",
    "interpretation": {
      "功名": "歷練方成",
      "婚姻": "好事多磨",
      "求財": "久後方得",
      "疾病": "頑疾難癒",
      "行人": "路途多阻",
      "年成": "收成較晚",
      "求嗣": "求之不易",
      "移居": "遠行多阻",
      "失物": "尋覓費力",
      "出行": "必有波折",
      "家宅": "平安無事",
      "訴訟": "持久糾纏",
      "學業": "歷練方成，勿輕放棄"
    }
  },
  {
    "id": 8,
    "level": "上吉签",
    "title": "關公斬蔡陽",
    "poem": "青龍偃月閃寒光\n義薄雲天膽氣剛\n單刀匹馬誅奸佞\n忠烈千秋姓字香",
    "judgment": "正義必勝，小人難逃法眼，堅守正道終獲善果。",
    "interpretation": {
      "功名": "剛正必達",
      "婚姻": "忠誠相守",
      "求財": "正財穩固",
      "疾病": "轉危為安",
      "行人": "安然歸返",
      "年成": "豐收在即",
      "求嗣": "勇健之子",
      "移居": "大利向東",
      "失物": "正人歸還",
      "出行": "旅程平安",
      "家宅": "正氣盈門",
      "訴訟": "正義必勝",
      "學業": "剛正勤學，必有所獲"
    }
  },
  {
    "id": 9,
    "level": "中下签",
    "title": "孟姜女哭長城",
    "poem": "千里尋夫到塞邊\n長城哭倒感人天\n世間離合皆天意\n莫把悲傷損玉顏",
    "judgment": "凡事多憂傷，宜節哀順變，過度悲傷無益於事。",
    "interpretation": {
      "功名": "期望勿高",
      "婚姻": "恐有離別",
      "求財": "得不償失",
      "疾病": "傷心損身",
      "行人": "歸期難料",
      "年成": "收成欠佳",
      "求嗣": "希望渺茫",
      "移居": "不宜遠行",
      "失物": "難以尋回",
      "出行": "多有不順",
      "家宅": "憂愁縈繞",
      "訴訟": "難免敗訴",
      "學業": "期望勿高，腳踏實地"
    }
  },
  {
    "id": 10,
    "level": "中上签",
    "title": "嫦娥奔月",
    "poem": "瓊樓玉宇廣寒宮\n寂寞嫦娥舞碧空\n靈藥偷來生羽翼\n清輝萬里照玲瓏",
    "judgment": "雖有成就，亦有孤寂，權衡得失再作決定。",
    "interpretation": {
      "功名": "高處不勝",
      "婚姻": "聚少離多",
      "求財": "名利雙收",
      "疾病": "需靜養之",
      "行人": "遠方安好",
      "年成": "收成尚可",
      "求嗣": "來之不易",
      "移居": "高遷可行",
      "失物": "高處尋找",
      "出行": "遠方大利",
      "家宅": "清幽雅靜",
      "訴訟": "雖勝有憾",
      "學業": "高處不勝，厚積薄發"
    }
  },
  {
    "id": 11,
    "level": "下下签",
    "title": "霸王別姬",
    "poem": "四面楚歌心膽寒\n英雄末路淚潸潸\n烏江自刎空遺恨\n蓋世豪情付水湍",
    "judgment": "大凶之兆，凡事多阻，宜退守以待時機，不可強行。",
    "interpretation": {
      "功名": "功敗垂成",
      "婚姻": "恐有生離",
      "求財": "血本無歸",
      "疾病": "病勢沉重",
      "行人": "音信全無",
      "年成": "顆粒無收",
      "求嗣": "求之不得",
      "移居": "動則大凶",
      "失物": "不可復得",
      "出行": "大凶勿行",
      "家宅": "恐有災厄",
      "訴訟": "必敗無疑",
      "學業": "大凶之年，宜靜勿爭"
    }
  },
  {
    "id": 12,
    "level": "上上签",
    "title": "諸葛亮借東風",
    "poem": "赤壁鏖兵待好風\n南屏山上祭蒼穹\n七星壇內施玄術\n一夜東南助火攻",
    "judgment": "天時地利人和俱備，萬事皆宜，只待東風。",
    "interpretation": {
      "功名": "一舉成名",
      "婚姻": "天賜良緣",
      "求財": "財源廣進",
      "疾病": "神醫可癒",
      "行人": "即日歸來",
      "年成": "大豐之年",
      "求嗣": "天賜貴子",
      "移居": "吉地大旺",
      "失物": "神助可得",
      "出行": "順風順水",
      "家宅": "福星高照",
      "訴訟": "天助必勝",
      "學業": "一舉成名，金榜題名"
    }
  },
  {
    "id": 13,
    "level": "中吉签",
    "title": "白蛇傳奇",
    "poem": "斷橋相遇定三生\n水漫金山動地驚\n雷峰塔下千年恨\n終得團圓感至誠",
    "judgment": "情深緣重，縱有劫難終得圓滿，堅守信念即可。",
    "interpretation": {
      "功名": "歷劫方成",
      "婚姻": "情深意重",
      "求財": "先失後得",
      "疾病": "久病可癒",
